# Local development defaults; SQLite is a development/test adapter only.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/platform.db
DATA_DIR=./data
JWT_SECRET=development-only-change-this-secret-at-least-32
SERVICE_KEY=development-service-key
ADMIN_PASSWORD=development-admin-password
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_MINUTES=15
MODEL_CONCURRENCY=4
MAX_UPLOAD_MB=20
MAX_CHUNKS=50000
QUERY_TIMEOUT_SECONDS=10
MAX_QUERY_ROWS=200
# Do not enable external tracing in an isolated factory network.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
