ENVIRONMENT=production
# Existing MySQL server. URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://agent_platform:REPLACE@192.168.1.10:3306/agent_platform?charset=utf8mb4
DATA_DIR=/app/data
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SERVICE_KEY=REPLACE_WITH_RANDOM_SERVICE_KEY_AT_LEAST_24_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ALLOWED_ORIGINS=https://agent.factory.internal,https://mes.factory.internal
TOKEN_MINUTES=15
MODEL_CONCURRENCY=4
MAX_CHUNKS=50000
QUERY_TIMEOUT_SECONDS=10
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
